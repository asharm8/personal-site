---
import { person, agency } from '../data/site';
const year = new Date().getFullYear();
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title">Let's talk.</h2>
    <div class="cols">
      <div class="col">
        <h3>About technology</h3>
        <p>A Drupal platform, a web rebuild, or automating the busywork in your business.</p>
        <div class="actions">
          <a class="btn btn-light" href={`mailto:${person.email}?subject=Project%20inquiry`}>Email {person.email}</a>
          <a class="btn btn-ghost" href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
      <div class="col">
        <h3>About insurance</h3>
        <p>Auto, home, business, or life coverage. Ask for me by name and I'll take care of you personally.</p>
        <div class="actions">
          <a class="btn btn-primary" href={agency.url} target="_blank" rel="noopener">Get a free quote</a>
          <a class="btn btn-ghost" href={agency.phoneHref}>Call {agency.phone}</a>
        </div>
      </div>
    </div>
  </div>
  <footer class="wrap footer">
    <p>&copy; {year} {person.name}</p>
    <p>
      <a href={person.github} target="_blank" rel="noopener">GitHub</a>
      <a href={person.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={agency.url} target="_blank" rel="noopener">{agency.name}</a>
    </p>
  </footer>
</section>

<style>
  .contact {
    background: var(--ink);
    color: #fff;
    padding-top: clamp(4rem, 9vw, 7rem);
  }
  h2 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 850;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem;
  }
  .col {
    border-top: 3px solid var(--sky);
    padding-top: 1.25rem;
  }
  h3 {
    font-size: 1.4rem;
    font-weight: 750;
    font-stretch: 110%;
    margin-bottom: 0.6rem;
  }
  .col p {
    color: #c9d6e8;
    max-width: 30rem;
    margin-bottom: 1.5rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .btn-light {
    background: #fff;
    color: var(--ink);
  }
  .btn-light:hover {
    background: var(--sky-pale);
    color: var(--ink);
  }
  .btn-ghost {
    border-color: rgba(255, 255, 255, 0.55);
    color: #fff;
  }
  .btn-ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(4rem, 8vw, 6rem);
    padding-block: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-family: var(--sans);
    font-size: 0.92rem;
    color: #a9bad3;
  }
  .footer p {
    margin: 0;
    display: flex;
    gap: 1.25rem;
  }
  .footer a {
    color: #fff;
  }
  @media (max-width: 44rem) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
