---
import Section from './Section.astro';
import { education, certifications } from '../data/site';
---

<Section id="credentials" title="Education & credentials">
  <div class="cols">
    <div>
      <h3>Education</h3>
      <ul>
        {
          education.map((e) => (
            <li>
              <strong>{e.school}</strong>
              <span>{e.program}</span>
              <span class="meta">{e.dates}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3>Licenses & certifications</h3>
      <ul>
        {
          certifications.map((c) => (
            <li>
              <strong>{c.name}</strong>
              <span class="meta">{c.issuer}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }
  h3 {
    font-size: 1.1rem;
    font-weight: 700;
    font-stretch: 110%;
    margin-bottom: 1rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    flex-direction: column;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    line-height: 1.45;
  }
  li:first-child {
    border-top: 1px solid var(--line);
  }
  strong {
    font-family: var(--sans);
    font-weight: 650;
  }
  @media (max-width: 40rem) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
