---
import Section from './Section.astro';
import { about, skills } from '../data/site';
---

<Section id="about" title="About">
  <div class="prose">
    {about.map((p) => <p>{p}</p>)}
  </div>
  <dl class="skills">
    {
      skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>{s.items.join(', ')}</dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .prose {
    max-width: 40rem;
    font-size: 1.2rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.5rem 2.5rem;
    margin: 0;
  }
  dt {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.98rem;
    margin-bottom: 0.25rem;
    padding-top: 0.6rem;
    border-top: 3px solid var(--sky);
  }
  dd {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.98rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }
</style>
