---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap section-grid">
    <div class="section-title-wrap">
      <h2 class="section-title" id={`${id}-title`}>{title}</h2>
    </div>
    <div class="section-body">
      <slot />
    </div>
  </div>
</section>
