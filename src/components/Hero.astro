---
import { person, practices } from '../data/site';
const keys = Object.keys(practices) as (keyof typeof practices)[];
---

<section class="hero" data-hero>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <h1 class="name">{person.name}</h1>

      <div class="switch" role="group" aria-label="What brings you here?">
        <span class="switch-label" id="switch-label">I'm here about</span>
        <div class="switch-track">
          {
            keys.map((k, i) => (
              <button
                type="button"
                class="switch-btn"
                data-practice={k}
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-controls={`practice-${k}`}
              >
                {practices[k].label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="panels">
      {
        keys.map((k, i) => {
          const p = practices[k];
          const external = p.cta.href.startsWith('http');
          return (
            <div class="practice" id={`practice-${k}`} data-panel={k} hidden={i !== 0}>
              <p class="lead">{p.lead}</p>
              <p class="body">{p.body}</p>
              <div class="actions">
                <a
                  class="btn btn-primary"
                  href={p.cta.href}
                  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {p.cta.label}
                </a>
                <a class="btn btn-secondary" href={p.secondary.href}>
                  {p.secondary.label}
                </a>
              </div>
            </div>
          );
        })
      }
      </div>
    </div>

    <figure class="portrait">
      <img src="/images/abhi.jpg" width="720" height="900" alt="Portrait of Abhi Sharma" fetchpriority="high" />
    </figure>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const buttons = hero.querySelectorAll<HTMLButtonElement>('[data-practice]');
    const panels = hero.querySelectorAll<HTMLElement>('[data-panel]');

    const select = (key: string, updateUrl = true) => {
      if (![...buttons].some((b) => b.dataset.practice === key)) return;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.practice === key)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== key));
      hero.dataset.active = key;
      if (updateUrl) {
        const url = new URL(location.href);
        if (key === 'technology') url.searchParams.delete('for');
        else url.searchParams.set('for', key);
        history.replaceState(null, '', url);
      }
    };

    buttons.forEach((b) => b.addEventListener('click', () => select(b.dataset.practice!)));

    // Links like asharm8.github.io/?for=insurance open on the insurance side.
    const initial = new URLSearchParams(location.search).get('for');
    if (initial) select(initial, false);
  }
</script>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }
  .hero-text {
    min-width: 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }
  .name {
    font-size: clamp(3.4rem, 9.5vw, 8.25rem);
    font-weight: 850;
    font-stretch: 125%;
    letter-spacing: -0.035em;
    line-height: 0.88;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 2rem;
    font-family: var(--sans);
  }
  .switch-label {
    font-size: 1rem;
    color: var(--ink-soft);
  }
  .switch-track {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 4px;
    border-radius: 999px;
    background: var(--sky-pale);
    border: 1px solid var(--line);
  }
  .switch-btn {
    font: inherit;
    font-weight: 650;
    font-size: 1rem;
    padding: 0.6rem 1.25rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  .switch-btn[aria-pressed='true'] {
    background: var(--ink);
    color: #fff;
  }
  .switch-btn:not([aria-pressed='true']):hover {
    background: #d6eef9;
  }

  /* Both panels share one grid cell so switching never shifts the layout */
  .panels {
    display: grid;
  }
  .practice {
    grid-area: 1 / 1;
    max-width: 38rem;
  }
  .practice[hidden] {
    display: block;
    visibility: hidden;
  }
  .practice:not([hidden]) {
    animation: settle 0.35s ease-out;
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  .lead {
    font-family: var(--sans);
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    font-weight: 700;
    font-stretch: 108%;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 0.9rem;
  }
  .body {
    color: var(--ink-soft);
    font-size: 1.15rem;
    margin-bottom: 1.75rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .portrait {
    margin: 0;
    position: relative;
    background: var(--sky-pale);
    border-radius: 14rem 14rem 0.5rem 0.5rem;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 26rem;
    justify-self: end;
    width: 100%;
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  /* Very narrow phones: three equal segments, labels may wrap */
  @media (max-width: 23rem) {
    .switch-track {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      width: 100%;
      border-radius: 1.4rem;
    }
    .switch-btn {
      white-space: normal !important;
      line-height: 1.15;
      padding: 0.55rem 0.4rem !important;
      border-radius: 1.1rem;
    }
  }
  @media (max-width: 30rem) {
    .switch-track {
      flex-wrap: nowrap;
    }
    .switch-btn {
      padding: 0.55rem 0.7rem;
      font-size: 0.88rem;
      white-space: nowrap;
    }
  }
  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      order: -1;
      justify-self: start;
      max-width: 9.5rem;
    }
  }
</style>
