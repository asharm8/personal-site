---
import Section from './Section.astro';
import { projects, projectGroups } from '../data/site';

const groups = projectGroups
  .map((g) => ({ ...g, items: projects.filter((p) => p.group === g.id) }))
  .filter((g) => g.items.length > 0);
---

<Section id="work" title="Selected work">
  {
    groups.map((g) => (
      <div class="group">
        <h3 class="group-title">{g.title}</h3>
        <ul class="projects">
          {g.items.map((p) => (
            <li class:list={['project', { 'no-image': !p.image }]}>
              {p.image && (
                <a class="shot" href={p.url || undefined} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                  <img src={p.image} alt="" width="1200" height="754" loading="lazy" />
                </a>
              )}
              <h4>
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener">
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </h4>
              <p class="meta">{p.context}</p>
              <p class="text">{p.text}</p>
              <p class="meta tags">{p.tags.join(', ')}</p>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</Section>

<style>
  .group + .group {
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }
  .group-title {
    font-size: 1.05rem;
    font-weight: 700;
    font-stretch: 112%;
    color: var(--sky-deep);
    margin-bottom: 1.75rem;
  }
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem 2.5rem;
  }
  /* The first project in each group spans the full width */
  .project:first-child {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    column-gap: 2.5rem;
    align-items: start;
  }
  .project:first-child .shot {
    grid-row: 1 / span 5;
  }
  .project:first-child h4 {
    font-size: 1.9rem;
  }
  /* Projects without a screenshot get a sky-blue top rule instead */
  .project.no-image {
    border-top: 3px solid var(--sky);
    padding-top: 1.1rem;
  }
  .shot {
    display: block;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--sky-pale);
    margin-bottom: 1.1rem;
  }
  .shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s ease;
  }
  .project:hover .shot img {
    transform: scale(1.025);
  }
  h4 {
    font-family: var(--sans);
    font-size: 1.45rem;
    font-weight: 750;
    font-stretch: 110%;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0 0 0.3rem;
    text-wrap: balance;
  }
  h4 a {
    color: var(--ink);
    text-decoration: none;
  }
  h4 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--sky);
    text-decoration-thickness: 2px;
  }
  .meta {
    margin-bottom: 0.7rem;
  }
  .text {
    margin-bottom: 0.6rem;
  }
  .tags {
    color: var(--sky-deep);
    font-weight: 500;
  }
  @media (max-width: 52rem) {
    .projects,
    .project:first-child {
      grid-template-columns: 1fr;
    }
    .project:first-child .shot {
      grid-row: auto;
    }
  }
</style>
